arg = record:
  name: string
  value: ref

view = record:
  base_view: ref
  name: string
  label: string
  model: ref opt  # Original model - base model for crud get and post commands.
#  remote_peer: ref opt
  args: arg list
  selector_pick_action: ref opt
  commit_action: ref
  commit_value_field: string

open_command = record:
  name: string
  value_t: ref
  key_fields: string list
  init_action: ref
  commit_action: ref

commit_command = record:
  model: ref opt  # Original model - base model for crud get and post commands.
  args: arg list
  selector_pick_action: ref opt
  commit_action: ref
  commit_value_field: string

commit_command_key = record:
  model: ref opt
  name: string

record_adapter = record

# model value should be different for all values or record adapter will pick wrong cached value.
form_model = record:
  model: ref opt
  record_t: ref
  init_action: ref
  args: arg list

layout_k = record:
  model_t: ref
  name: string
