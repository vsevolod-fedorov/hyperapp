from path import path

import_job = record:
  target: string
  path: path
  source: string
  cfg_items: ref list  # Of any type; import recorder picks its own.

# Module-level function named with 'test_' prefix.
test_function = record:
  name: string
  params: string list
  is_async: bool  # Async generator is both async and generator.
  is_generator: bool

succeeded_result = record:
  target: string
  requirements: ref list
  test_functions: test_function list

incomplete_result = record:
  target: string
  requirements: ref list

failed_result = record:
  target: string
  requirements: ref list
  error: string
  traceback: string list

# Error in the import job itself, not in the imported module.
internal_error_result = record:
  target: string
  error: string
  traceback: string list
