model = record

item = record:
  id: int
  name: string
  focusable: bool
  description: string


command_list = record:
  item_id: int

command_item = record:
  name: string
  shortcut: string
  groups: string
  wrapped_groups: string


layout_command_impl = record:
  item_id: int
  command_d: ref
  ui_command_impl: ref


layout_ui_command_key = record:
  base_key: ref
